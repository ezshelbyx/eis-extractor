[Desktop Entry]
Type=Application
Name=E.I.S EXTRACTOR
GenericName=Archive Manager
Comment=Native Linux archive extractor
Exec=eis-extractor %F
Icon=eis-extractor
Terminal=false
Categories=Utility;Archiving;KDE;
